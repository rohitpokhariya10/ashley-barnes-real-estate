# Server-only. HTTPS endpoint (CRM, Zapier/Make webhook, custom API) that
# receives consultation requests as a JSON POST. Until this is set, the form
# reports that the request was NOT sent — it never shows a false success.
LEAD_WEBHOOK_URL=

# Optional. Sent as "Authorization: Bearer <secret>" to the endpoint above.
LEAD_WEBHOOK_SECRET=

# Verified production origin (no trailing slash). Enables canonical URL,
# Open Graph URLs and the `url` field in structured data.
NEXT_PUBLIC_SITE_URL=
