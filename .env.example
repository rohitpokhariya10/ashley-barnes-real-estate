# Server-only. HTTPS endpoint (CRM, Zapier/Make webhook, custom API) that
# receives consultation requests as a JSON POST. Until this is set, the form
# reports that the request was NOT sent — it never shows a false success.
LEAD_WEBHOOK_URL=

# Optional. Sent as "Authorization: Bearer <secret>" to the endpoint above.
LEAD_WEBHOOK_SECRET=

# Verified production origin (no trailing slash). Enables canonical URL,
# Open Graph URLs and the `url` field in structured data.
NEXT_PUBLIC_SITE_URL=

# Optional SABOR MLS IDX overrides, read at build time. Leave empty to use
# src/lib/idx.ts (see "IDX property search" in the README).
# IDX_MODE: auto | inactive | hosted | embed. "embed" also needs an https IDX_EMBED_URL.
IDX_MODE=
IDX_SEARCH_URL=
IDX_EMBED_URL=
# Seconds between automatic availability checks in "auto" mode (default 300, 30–3600).
IDX_CHECK_INTERVAL_SECONDS=

# Local machines only — never set in Vercel. Shows the unlicensed listing photo
# kept in the git-ignored public/local-preview/ folder (see README "My Active Listing").
LOCAL_LISTING_PHOTO_PREVIEW=
